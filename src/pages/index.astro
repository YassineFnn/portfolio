---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/content';

const featured = projects.slice(0, 2);
---

<BaseLayout title="Yassine Founounou — Software Developer" description="Software developer in Munich building reliable systems, applied AI products, and thoughtful interfaces." activePage="home">
  <section class="hero">
    <div class="page-shell hero-grid">
      <div class="hero-copy" data-reveal>
        <p class="eyebrow">Software developer · Munich</p>
        <h1 class="display-title">Complex systems<br /><span class="gradient-text">Clear solutions</span></h1>
        <p class="hero-lede">I build software to solve real engineering problems.</p>
        <div class="button-row">
          <a class="button button--primary" href="/projects/">Projects <span class="arrow" aria-hidden="true">↗</span></a>
          <a class="button button--quiet" href="/about/">About me <span class="arrow" aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-visual" data-reveal>
        <div class="portrait-frame">
          <img class="portrait-image" src="/yassine-portrait.png" alt="Portrait of Yassine Founounou" fetchpriority="high" />
          <span class="portrait-caption">Yassine Founounou <span>·</span> Munich</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section--compact">
    <div class="page-shell">
      <div class="section-heading" data-reveal>
        <div class="section-heading-copy">
          <h2 class="section-title">Currently</h2>
        </div>
      </div>
      <div class="bento-grid">
        <article class="bento-card bento-card--large" data-reveal>
          <p class="card-label">Work Study · Acronis</p>
          <h3 class="card-title">Software Developer</h3>
          <p class="card-copy">Built Genie, an internal web app that automates virtual machine setup and tracks deployments.</p>
        </article>
        <article class="bento-card bento-card--large" data-reveal>
          <p class="card-label">Work Study · Somatric</p>
          <h3 class="card-title">AI Engineer</h3>
          <p class="card-copy">Interdisciplinary Project · IN2334 · TUM.</p>
        </article>
        <article class="bento-card bento-card--large" data-reveal>
          <p class="card-label">Work Study · Soley</p>
          <h3 class="card-title">AI Engineer - Team Lead</h3>
          <p class="card-copy">In collaboration with CSEE.</p>
        </article>
        <article class="bento-card bento-card--large" data-reveal>
          <p class="card-label">Current studies · TUM</p>
          <h3 class="card-title">Master of Science, Computer Science</h3>
          <p class="card-copy">Artificial intelligence, software engineering, and security.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-shell">
      <div class="section-heading" data-reveal>
        <div class="section-heading-copy">
          <h2 class="section-title">Selected projects</h2>
        </div>
        <a class="text-link" href="/projects/">View all <span class="arrow" aria-hidden="true">↗</span></a>
      </div>
      <div class="work-grid">
        {featured.map((project, index) => (
          <a class="project-card" href="/projects/" data-reveal class:list={[index === 1 && 'delay-1']}>
            <div class="project-card-top"><span class="project-number">/{project.number}</span><span class="project-category">{project.category}</span></div>
            <div class="project-graphic" aria-hidden="true">
              {index === 0 ? (
                <svg viewBox="0 0 430 130"><path class="graphic-line dim" d="M52 67h70m58 0h72m55 0h72"/><rect class="graphic-line" x="20" y="43" width="40" height="48" rx="9"/><rect class="graphic-line" x="136" y="43" width="47" height="48" rx="9"/><rect class="graphic-line" x="254" y="43" width="48" height="48" rx="9"/><rect class="graphic-line" x="370" y="43" width="40" height="48" rx="9"/><circle class="graphic-point" cx="82" cy="67" r="3"/><circle class="graphic-point" cx="223" cy="67" r="3"/><circle class="graphic-point" cx="337" cy="67" r="3"/></svg>
              ) : (
                <svg viewBox="0 0 430 130"><circle class="graphic-line" cx="215" cy="65" r="48"/><circle class="graphic-line dim" cx="215" cy="65" r="72"/><path class="graphic-line" d="M183 65h64M215 33v64M191 43l48 44M239 43l-48 44"/><circle class="graphic-point" cx="215" cy="17" r="4"/><circle class="graphic-point" cx="286" cy="65" r="4"/><circle class="graphic-point" cx="144" cy="65" r="4"/></svg>
              )}
            </div>
            <div>
              <h3>{project.title}</h3>
              <p>{project.intro}</p>
            </div>
            <div class="project-card-footer"><div class="tag-row">{project.stack.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}</div><span class="project-arrow" aria-hidden="true">↗</span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
