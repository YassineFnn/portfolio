---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projects } from '../../data/content';
---

<BaseLayout title="Projects — Yassine Founounou" description="Selected projects in infrastructure automation, applied AI, distributed systems, and developer tooling." activePage="projects">
  <section class="page-hero">
    <div class="page-shell page-hero-inner" data-reveal>
      <h1 class="display-title">Selected <span class="gradient-text">work</span></h1>
    </div>
  </section>

  <section class="section--compact">
    <div class="page-shell case-study-list">
      {projects.map((project, index) => (
        <article class="case-study" data-reveal>
          <div class="case-study-top">
            <div><p class="section-kicker">{project.number} <span aria-hidden="true">/</span> {project.category}</p><h2 class="case-study-title">{project.title}</h2></div>
            <div class="case-study-visual" aria-label={`Abstract visualization for ${project.title}`}>
              <div class="visual-core">{['FLOW','RAG','AST'][index]}</div>
              <div class="case-study-metrics"><span>{index === 0 ? '28 → 1.5 min' : index === 1 ? '1,000+ cards' : '+51% precision'}</span><span>ENGINEERED WITH INTENT</span></div>
            </div>
          </div>
          <div class="case-study-body">
            <div class="case-study-column"><h3>Problem</h3><p>{project.problem}</p></div>
            <div class="case-study-column"><h3>Solution</h3><p>{project.solution}</p></div>
            <div class="case-study-column"><h3>Impact</h3><p>{project.impact}</p></div>
          </div>
          <div class="tag-row case-tags">{project.stack.map((tag) => <span class="tag">{tag}</span>)}</div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
